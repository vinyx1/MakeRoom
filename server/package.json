{
  "name": "makeroom-server",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server/main.ts",
    "dev": "node --watch src/server/main.ts",
    "dev:test-card": "DEV_TEST_CARD=1 node --watch src/server/main.ts",
    "try": "node scripts/try.ts",
    "smoke": "node scripts/smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "5.12.7",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
